# Postgres. Neon: paste the connection string. Local: see README (PGlite).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# Set to false for local databases without TLS
DB_SSL=false

# Clerk: Dashboard > Configure > API keys > "Frontend API URL"
# e.g. https://your-app.clerk.accounts.dev
JWT_ISSUER=

# Comma-separated frontend origins (also checked against Clerk's azp claim)
CORS_ORIGINS=http://localhost:8080

# Signs guest-session tokens. Any long random string; if unset, a random one
# is used per process and guest sessions end on restart.
GUEST_JWT_SECRET=
